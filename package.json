{
	"name": "annoying-teammate-reviewer",
	"version": "1.0.0",
	"description": "AI-powered code reviewer with customizable personality. Supports Ollama (local), Claude, OpenAI, and Gemini.",
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"review": "./dist/index.js"
	},
	"keywords": [
		"code-review",
		"ai",
		"llm",
		"ollama",
		"claude",
		"openai",
		"gemini",
		"cli"
	],
	"author": "Emilio Dominguez",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emiliodominguez/annoying-teammate-reviewer.git"
	},
	"bugs": {
		"url": "https://github.com/emiliodominguez/annoying-teammate-reviewer/issues"
	},
	"homepage": "https://github.com/emiliodominguez/annoying-teammate-reviewer#readme",
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsx watch src/index.ts",
		"review": "tsx src/index.ts",
		"review:staged": "tsx src/index.ts --staged",
		"review:branch": "tsx src/index.ts --branch",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
		"test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.71.1",
		"@google/generative-ai": "^0.24.1",
		"chalk": "^5.3.0",
		"commander": "^12.1.0",
		"marked": "^15.0.12",
		"marked-terminal": "^7.3.0",
		"openai": "^6.10.0",
		"ora": "^8.1.0"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/marked-terminal": "^6.1.1",
		"@types/node": "^22.10.1",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	}
}

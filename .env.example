# Annoying Teammate Code Reviewer - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# PROVIDER SELECTION
# =============================================================================

# Default LLM provider to use (ollama, claude, openai, gemini)
# Default: ollama
LLM_PROVIDER=ollama

# =============================================================================
# OLLAMA (Local LLM)
# =============================================================================

# Ollama API URL (only needed if running on non-default host/port)
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Default model for Ollama
# Recommended: deepcoder, qwen3, codellama
# Default: deepcoder
OLLAMA_DEFAULT_MODEL=deepcoder

# =============================================================================
# CLAUDE (Anthropic)
# =============================================================================

# Anthropic API key (required for Claude provider)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Default model for Claude
# Available: claude-opus-4-5, claude-sonnet-4-5, claude-haiku-4-5
# Default: claude-sonnet-4-5-20250929
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-5-20250929

# =============================================================================
# OPENAI
# =============================================================================

# OpenAI API key (required for OpenAI provider)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# OpenAI API base URL (only needed for Azure OpenAI or compatible APIs)
# Default: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Default model for OpenAI
# Available: gpt-5.1, gpt-5-mini, gpt-5-nano, gpt-4.1, gpt-4.1-mini, gpt-4.1-nano, o3, o4-mini
# Default: gpt-4.1
OPENAI_DEFAULT_MODEL=gpt-4.1

# =============================================================================
# GEMINI (Google)
# =============================================================================

# Google AI API key (required for Gemini provider)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=...

# Alternative env var name for Google AI API key
# GEMINI_API_KEY=...

# Default model for Gemini
# Available: gemini-2.5-pro, gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.0-flash
# Default: gemini-2.5-flash
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# =============================================================================
# REVIEW SETTINGS
# =============================================================================

# Review strictness level (lenient, normal, strict)
# Default: normal
REVIEW_STRICTNESS=normal
